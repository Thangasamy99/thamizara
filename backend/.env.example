# ── THAMIZARA API — example environment file ──────────────────────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# Server
NODE_ENV=development
PORT=4000
APP_NAME="THAMIZARA API"

# Comma-separated list of allowed browser origins (public site + admin app)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL (use a dedicated application user — NEVER the root account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thamizora
DB_USER=thamizora_app
DB_PASSWORD=change-me-in-production
DB_CONNECTION_LIMIT=10

# JWT — generate long random secrets (e.g. `openssl rand -hex 64`)
JWT_ISSUER=thamizara-api
JWT_AUDIENCE=thamizara-admin
JWT_ACCESS_SECRET=dev-only-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-secret-change-me
JWT_REFRESH_TTL_DAYS=30

# bcrypt hashing cost
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_MAX=20

# Logging (pino levels: fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# SMTP (Nodemailer) — leave blank to disable email sending safely
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="THAMIZARA Technologies <no-reply@thamizara.com>"

# Comma-separated admin notification recipients
ADMIN_NOTIFY_EMAILS=

# Password reset + admin app URL (for reset links)
PASSWORD_RESET_TTL_MINUTES=60
ADMIN_APP_URL=http://localhost:5174

# Public site URL (for email links) + enquiry tuning
PUBLIC_SITE_URL=http://localhost:5173
STATUS_TOKEN_TTL_DAYS=180
IDEMPOTENCY_TTL_HOURS=24
NOTIFICATION_MAX_ATTEMPTS=5
